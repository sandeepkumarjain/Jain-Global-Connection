{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Registered Jain Connect member profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "role": { "type": "string", "enum": ["user", "admin", "sangh_leader"] },
        "themePreference": { "type": "string", "enum": ["light", "dark", "auspicious"] },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "savedRituals": { "type": "array", "description": "User bookmarked puja rituals and procedures" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "MatrimonialProfile": {
      "title": "Matrimonial Profile",
      "description": "Profile for Jain matchmaking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string", "maxLength": 100 },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "age": { "type": "number" },
        "sect": { "type": "string", "maxLength": 50 },
        "education": { "type": "string", "maxLength": 150 },
        "occupation": { "type": "string", "maxLength": 150 },
        "city": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["fullName", "gender", "age", "userId"]
    },
    "BusinessListing": {
      "title": "Jain Business Listing",
      "description": "Verified Jain entrepreneur directory listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessName": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 100 },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["businessName", "category", "ownerId"]
    },
    "FeedPost": {
      "title": "Community Feed Post",
      "description": "Post or announcement in community feed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "content": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 50 },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["authorId", "content"]
    },
    "SanghaMandal": {
      "title": "Local Jain Sangha / Mandal",
      "description": "Registered Jain Sangha or Local Mandal profile linked to Mandal Admin lead",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "applicationId": { "type": "string" },
        "ownerUserId": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 80 },
        "tradition": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 400 },
        "contactPerson": { "type": "string", "maxLength": 120 },
        "contactRole": { "type": "string", "maxLength": 100 },
        "mobile": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "adminEmail": { "type": "string", "format": "email", "maxLength": 150 },
        "isVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["Pending Approval", "Approved", "Rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "city", "contactPerson", "mobile"]
    },
    "Notification": {
      "title": "App Notification",
      "description": "Community or user-targeted notification alert",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 50 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "message"]
    },
    "MandalAdmin": {
      "title": "Mandal Admin Credential",
      "description": "Dedicated Mandal Admin lead credentials linked to a registered Local Mandal profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "password": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 120 },
        "mobile": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["Mandal Admin"] },
        "mandalId": { "type": "string" },
        "mandalName": { "type": "string", "maxLength": 200 },
        "applicationId": { "type": "string" },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "isVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["Pending Approval", "Approved", "Rejected", "Suspended"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "password", "mandalId", "mandalName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/matrimonial_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/MatrimonialProfile" },
      "description": "Matchmaking profiles"
    },
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/BusinessListing" },
      "description": "Jain business directory"
    },
    "/feed_posts/{postId}": {
      "schema": { "$ref": "#/entities/FeedPost" },
      "description": "Global community posts"
    },
    "/sanghas/{sanghaId}": {
      "schema": { "$ref": "#/entities/SanghaMandal" },
      "description": "Global Sangha & Local Mandals collection"
    },
    "/mandal_admins/{adminId}": {
      "schema": { "$ref": "#/entities/MandalAdmin" },
      "description": "Mandal Admin credentials and linked Mandal session records"
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System and user notifications"
    }
  }
}
